# Supabase — get from: https://supabase.com/dashboard/project/<your-project>/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# PostHog — get from: https://app.posthog.com/project/settings
EXPO_PUBLIC_POSTHOG_API_KEY=phc_<your-key>

# Sentry — get from: https://sentry.io/settings/<org>/projects/<project>/keys/
EXPO_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>
